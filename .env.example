# ── Локальная разработка без Docker ─────────────────────────────
# Скопируйте в .env (он в .gitignore) и укажите свою БД.
# Драйвер можно не писать: postgresql://... превратится в postgresql+psycopg://...
# Спецсимволы в пароле (@ : / # ?) кодируются: @ -> %40, : -> %3A
DATABASE_URL=postgresql+psycopg://churn:churn@localhost:5432/churn

# Необязательные параметры подключения
# DB_CONNECT_TIMEOUT=5
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=15

# При старте бэкенд сам выполняет alembic upgrade head; 0 — выключить
# AUTO_MIGRATE=1

# Вход через OIDC (SSO); без OIDC_ISSUER выключен, остаётся логин и пароль. Подробнее — README
# OIDC_ISSUER=http://localhost:8180/realms/saveflow
# OIDC_CLIENT_ID=saveflow-panel
# OIDC_REDIRECT_URI=http://localhost:5173/api/v1/auth/oidc/callback
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
# OIDC_REQUIRED_ROLE=analyst
# OIDC_NAME=Keycloak

# ── Docker Compose (docker compose up --build) ──────────────────
# Все переменные необязательны, значения по умолчанию указаны справа.
# В Docker адрес БД собирается из DB_PASSWORD, DATABASE_URL выше не используется.
# DB_PASSWORD=churn        # только буквы и цифры, иначе сломается адрес БД
# DEMO_USER=admin
# DEMO_PASSWORD=admin      # поменяйте перед показом жюри
# PUBLIC_HOST=localhost    # на сервере — его IP или домен, иначе вход через Keycloak уводит на localhost
# APP_PORT=8080
# SEED_ON_START=1
# SESSION_TTL_HOURS=12
# KEYCLOAK_PORT=8180
# KEYCLOAK_ADMIN_PASSWORD=admin
