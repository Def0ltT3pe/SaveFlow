# Скопируйте в .env (он в .gitignore) и укажите свою БД.
# Драйвер можно не писать: postgresql://... превратится в postgresql+psycopg://...
# Спецсимволы в пароле (@ : / # ?) кодируются: @ -> %40, : -> %3A
DATABASE_URL=postgresql+psycopg://churn:churn@localhost:5432/churn

# Необязательные параметры подключения
# DB_CONNECT_TIMEOUT=5
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=15
